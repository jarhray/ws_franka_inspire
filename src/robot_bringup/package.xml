<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch and parameter orchestration for FR3 + Inspire + RealSense policy pipeline.</description>
  <maintainer email="todo@todo.todo">robot_bringup</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>franka_bringup</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>inspire_hand_modbus_ros2</exec_depend>
  <exec_depend>observation_aggregator</exec_depend>
  <exec_depend>policy_manager</exec_depend>
  <exec_depend>action_router</exec_depend>
  <exec_depend>fr3_franky_executor</exec_depend>
  <exec_depend>inspire_executor</exec_depend>
  <exec_depend>experiment_logger</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
